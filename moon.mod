name = "moonbitstack/moontoken"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontoken"

license = "Apache-2.0"

keywords = [
  "tokenizer",
  "tokenizers",
  "tokenization",
  "token",
  "count-tokens",
  "bpe",
  "byte-pair-encoding",
  "byte-level-bpe",
  "sentencepiece",
  "unigram",
  "tiktoken",
  "cl100k",
  "cl100k_base",
  "o200k",
  "o200k_base",
  "r50k_base",
  "p50k_base",
  "tokenizer-json",
  "vocabulary",
  "vocab",
  "merges",
  "encode",
  "decode",
  "special-tokens",
  "byte-fallback",
  "pre-tokenizer",
  "normalization",
  "nlp",
  "llm",
  "prompt",
  "context-window",
  "moonbit",
]

description = "Tokenizers for MoonBit: byte-level BPE and SentencePiece."

source = "src"

import {
  "moonbitstack/moonucd@0.1.4",
  "moonbitlang/x@0.5.7",
}
